<Window x:Class="MclLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MclLauncher"
        Height="700" Width="1080"
        MinHeight="580" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource BrushBgApp}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="{StaticResource FontUI}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= 标题栏 ================= -->
            <Grid Grid.Row="0" Background="{StaticResource BrushBgSide}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="4">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4A9BD8" Offset="0" />
                                <GradientStop Color="#1370B5" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="M" Foreground="White" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="MclLauncher" Margin="8,0,0,0" FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click">
                        <TextBlock x:Name="MaxIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="Close_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= 主体 ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="244" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：版本列表 -->
                <Border Grid.Column="0" Background="{StaticResource BrushBgSide}"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="20,16,20,8">
                            <TextBlock Text="版本列表" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding VersionCountText}" Style="{StaticResource CaptionText}"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Versions}"
                                 SelectedItem="{Binding SelectedVersion}"
                                 Style="{StaticResource VersionList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="34" Height="34" CornerRadius="7">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#4A9BD8" Offset="0" />
                                                    <GradientStop Color="#1370B5" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Initial}" Foreground="White"
                                                       FontSize="15" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Id}" FontSize="13.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Margin="14,8,14,14">
                            <Border Background="{StaticResource BrushBgCard}" CornerRadius="8"
                                    Padding="10" Cursor="Hand" BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1" ToolTip="点击切换账号">
                                <Border.InputBindings>
                                    <MouseBinding Command="{Binding LoginCommand}" MouseAction="LeftClick" />
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="15">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#4A9BD8" Offset="0" />
                                                <GradientStop Color="#1370B5" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="{Binding AccountInitial}" Foreground="White"
                                                   FontSize="13" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AccountName}" FontSize="12.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding AccountBadge}" FontSize="10.5"
                                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Button Content="刷新列表" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                    Command="{Binding RefreshCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 右侧 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 导航 -->
                    <Grid Grid.Row="0" Margin="22,12,22,4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="NavHome" Content="主页" IsChecked="True"
                                         Style="{StaticResource NavTab}" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavDownload" Content="下载"
                                         Style="{StaticResource NavTab}" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavSettings" Content="设置"
                                         Style="{StaticResource NavTab}" Checked="Nav_Checked" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                    </Grid>

                    <!-- 内容区 -->
                    <Grid Grid.Row="1" Margin="22,6,22,8">

                        <!-- ===== 主页 ===== -->
                        <Grid x:Name="PageHome">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="24">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="当前版本" Style="{StaticResource CaptionText}" />
                                            <TextBlock Text="{Binding SelectedVersionTitle}" FontSize="26"
                                                       FontWeight="SemiBold" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding SelectedVersionMeta}"
                                                       Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" VerticalAlignment="Center"
                                                Background="{StaticResource BrushAccentLight}"
                                                CornerRadius="6" Padding="12,7">
                                            <TextBlock Text="{Binding SelectedVersion.JavaHint}"
                                                       Foreground="{StaticResource BrushAccent}" FontSize="12" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="Java 运行时" Style="{StaticResource CaptionText}" />
                                            <TextBlock Text="{Binding JavaStatusText}" FontSize="13"
                                                       Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="分配内存" Style="{StaticResource CaptionText}" />
                                            <TextBlock Text="{Binding MemoryText}" FontSize="13" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="游戏目录" Style="{StaticResource CaptionText}" />
                                            <TextBlock Text="{Binding Paths.Root}" FontSize="12" Margin="0,7,0,0"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Paths.Root}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0" MinHeight="150">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Margin="18,12,18,6">
                                            <TextBlock Text="运行日志" Style="{StaticResource SectionTitle}"
                                                       VerticalAlignment="Center" />
                                            <Button Content="打开日志目录" Style="{StaticResource GhostButton}"
                                                    Height="26" Padding="10,0" FontSize="12"
                                                    HorizontalAlignment="Right" Command="{Binding OpenLogCommand}" />
                                        </Grid>
                                        <TextBox x:Name="LogBox" Grid.Row="1" Text="{Binding LogText, Mode=OneWay}"
                                                 IsReadOnly="True" IsUndoEnabled="False"
                                                 Background="Transparent" BorderThickness="0"
                                                 FontFamily="{StaticResource FontMono}" FontSize="11.5"
                                                 Foreground="{StaticResource BrushTextSecondary}"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 TextWrapping="NoWrap" Padding="18,0,18,12" />
                                    </Grid>
                                </Border>
                        </Grid>

                        <!-- ===== 下载 ===== -->
                        <Grid x:Name="PageDownload" Visibility="Collapsed"
                              DataContext="{Binding Download}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <StackPanel>
                                            <TextBlock Text="下载游戏" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding LatestText}" Style="{StaticResource CaptionText}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <CheckBox Content="显示快照" IsChecked="{Binding ShowSnapshots}"
                                                      VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12" />
                                            <Button Content="刷新列表" Style="{StaticResource GhostButton}"
                                                    Command="{Binding LoadCommand}" />
                                            <CheckBox Content="自动刷新" IsChecked="{Binding AutoRefreshEnabled}"
                                                      VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" />
                                            <TextBlock Text="{Binding AutoRefreshStatusText}" Style="{StaticResource CaptionText}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="96" />
                                            <Button Content="导入本地整合包" Style="{StaticResource GhostButton}"
                                                    Command="{Binding ImportCommand}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                        <RadioButton Content="游戏本体" IsChecked="{Binding IsVersionMode}"
                                                     Style="{StaticResource NavTab}" />
                                        <RadioButton Content="在线整合包" IsChecked="{Binding IsModpackMode}"
                                                     Style="{StaticResource NavTab}" />
                                        <TextBlock Text="来自 CurseForge 官方 API，需 key" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Border Style="{StaticResource Card}" Padding="0"
                                    Visibility="{Binding IsVersionMode, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="18,12,18,4">
                                        <TextBlock Text="可选版本" Style="{StaticResource SectionTitle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding VersionCountText}"
                                                   Style="{StaticResource CaptionText}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding Versions}"
                                             SelectedItem="{Binding Selected}"
                                             Style="{StaticResource VersionList}"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="32" Height="32" CornerRadius="7">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#4A9BD8" Offset="0" />
                                                                <GradientStop Color="#1370B5" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <TextBlock Text="{Binding Initial}" Foreground="White"
                                                                   FontSize="14" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Id}" FontSize="13" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="{StaticResource BrushAccentLight}"
                                                            CornerRadius="4" Padding="7,2" VerticalAlignment="Center"
                                                            Visibility="{Binding Installed, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="已安装" FontSize="10"
                                                                   Foreground="{StaticResource BrushAccent}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="0"
                                    Visibility="{Binding IsModpackMode, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="18,12,18,4">
                                        <TextBlock Text="在线整合包" Style="{StaticResource SectionTitle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SourceBadgeText}"
                                                   Style="{StaticResource CaptionText}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding ModpackItems}"
                                             SelectedItem="{Binding SelectedModpackItem}"
                                             Style="{StaticResource VersionList}"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="32" Height="32" CornerRadius="7">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#5DCAA5" Offset="0" />
                                                                <GradientStop Color="#0F6E56" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <TextBlock Text="{Binding Initial}" Foreground="White"
                                                                   FontSize="14" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="13"
                                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding VersionText}" FontSize="11"
                                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                                   Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding Description}" FontSize="10.5"
                                                                   Foreground="{StaticResource BrushTextTertiary}"
                                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="{StaticResource BrushAccentLight}"
                                                            CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DownloadText}" FontSize="10"
                                                                   Foreground="{StaticResource BrushAccent}" />
                                                    </Border>
                                                </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid Grid.Row="2" Margin="18,8,18,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="上一页" Style="{StaticResource GhostButton}"
                                                Command="{Binding PrevModpackPageCommand}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="1" Text="{Binding ModpackPageText}"
                                                   Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" Margin="14,0" MinWidth="70"
                                                   TextAlignment="Center" />
                                        <Button Grid.Column="2" Content="下一页" Style="{StaticResource GhostButton}"
                                                Command="{Binding NextModpackPageCommand}" HorizontalAlignment="Left" />
                                    </Grid>
                                </Grid>
                            </Border>
                            </Grid>

                            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedListText}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Stage}" Style="{StaticResource CaptionText}"
                                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding IsVersionMode, Converter={StaticResource BoolToVisibility}}">
                                            <ComboBox ItemsSource="{Binding LoaderTypes}"
                                                      SelectedItem="{Binding SelectedLoaderType}"
                                                      Width="92" Height="34" FontSize="12.5"
                                                      VerticalContentAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding LoaderVersions}"
                                                      SelectedItem="{Binding SelectedLoaderVersion}"
                                                      Width="148" Height="34" FontSize="12.5" Margin="8,0,0,0"
                                                      VerticalContentAlignment="Center"
                                                      Visibility="{Binding IsLoaderMode, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="{Binding InstallButtonText}" Style="{StaticResource PrimaryButton}"
                                                    Height="36" Width="130" Margin="10,0,0,0"
                                                    Command="{Binding InstallCommand}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding IsModpackMode, Converter={StaticResource BoolToVisibility}}">
                                            <TextBox Text="{Binding ModpackQuery, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputBox}" Width="176" Height="34"
                                                     VerticalContentAlignment="Center" />
                                            <Button Content="搜索" Style="{StaticResource GhostButton}" Height="34"
                                                    Command="{Binding SearchCommand}" Margin="8,0,0,0" />
                                            <Button Content="安装整合包" Style="{StaticResource PrimaryButton}"
                                                    Height="36" Width="130" Margin="10,0,0,0"
                                                    Command="{Binding InstallModpackCommand}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                        <ProgressBar Style="{StaticResource FlatProgress}"
                                                     Value="{Binding Percent, Mode=OneWay}" Maximum="100" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}"
                                                   Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ===== 设置 ===== -->
                        <ScrollViewer x:Name="PageSettings" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Padding="24">
                                    <StackPanel>
                                        <TextBlock Text="游戏设置" FontSize="18" FontWeight="SemiBold"
                                                   Margin="0,0,0,18" />

                                        <TextBlock Text="玩家名称" Style="{StaticResource SectionTitle}" />
                                        <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputBox}" Margin="0,8,0,0" Width="260"
                                                 HorizontalAlignment="Left" />

                                        <TextBlock Text="分配内存" Style="{StaticResource SectionTitle}" Margin="0,20,0,0" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="512" Maximum="16384" TickFrequency="512"
                                                    IsSnapToTickEnabled="True" SmallChange="512" LargeChange="1024"
                                                    Value="{Binding MemoryMb}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding MemoryText}" FontSize="13"
                                                       Margin="14,0,0,0" VerticalAlignment="Center" Width="80"
                                                       TextAlignment="Right" />
                                        </Grid>

                                        <TextBlock Text="Java 运行时" Style="{StaticResource SectionTitle}" Margin="0,20,0,0" />
                                        <ComboBox ItemsSource="{Binding JavaRuntimes}"
                                                  SelectedItem="{Binding SelectedJava}"
                                                  Margin="0,8,0,0" Width="420" Height="34"
                                                  HorizontalAlignment="Left" FontSize="13" />
                                        <TextBlock Text="{Binding JavaStatusText}" Style="{StaticResource CaptionText}"
                                                   Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="24">
                                    <StackPanel>
                                        <TextBlock Text="CurseForge API key" Style="{StaticResource SectionTitle}" />
                                        <TextBox Text="{Binding CurseForgeKey, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputBox}" Margin="0,8,0,0" />
                                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                   Margin="0,8,0,0"
                                                   Text="在线整合包仅从 CurseForge 官方库搜索和下载（下载页的「在线整合包」立即生效）。去 console.curseforge.com → API keys 申请组织密钥，免费。不填则在线搜索不可用。" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="24">
                                    <StackPanel>
                                        <TextBlock Text="游戏目录" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding Paths.Root}" Style="{StaticResource CaptionText}"
                                                   Margin="0,8,0,0" TextWrapping="Wrap" />
                                        <Button Content="打开目录" Style="{StaticResource GhostButton}"
                                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                                Command="{Binding OpenGameFolderCommand}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 启动栏 -->
                    <Border Grid.Row="2" Background="{StaticResource BrushBgSide}"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                            Padding="22,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedVersionTitle}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0">
                                    <Run Text="{Binding JavaStatusText, Mode=OneWay}" />
                                    <Run Text="  ·  " />
                                    <Run Text="{Binding MemoryText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="结束" Style="{StaticResource GhostButton}" Height="40"
                                        Command="{Binding StopCommand}" Margin="0,0,10,0"
                                        Visibility="{Binding IsLaunching, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="{Binding LaunchButtonText}" Style="{StaticResource PrimaryButton}"
                                        Width="156" Command="{Binding LaunchCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
