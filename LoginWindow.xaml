<Window x:Class="MclLauncher.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="登录"
        Width="450" Height="512"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgCard}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="{StaticResource FontUI}"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource BrushBgSide}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="账号登录" Margin="16,0,0,0" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Click="Close_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="18,10,18,0">
                <RadioButton x:Name="TabOffline" Content="离线登录" IsChecked="True"
                             Style="{StaticResource NavTab}" Checked="Tab_Checked" />
                <RadioButton x:Name="TabMsa" Content="微软正版"
                             Style="{StaticResource NavTab}" Checked="Tab_Checked" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="20,12,20,20">

                <StackPanel x:Name="PanelOffline">
                    <TextBlock Text="玩家名称" Style="{StaticResource SectionTitle}" Margin="0,8,0,0" />
                    <TextBox x:Name="OfflineName" Style="{StaticResource InputBox}" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="离线模式不验证账号，只能进离线服务器。UUID 由用户名在本地按 Mojang 的规则生成，同一个名字永远是同一个 UUID。" />
                    <Button Content="使用离线账号" Style="{StaticResource PrimaryButton}"
                            Margin="0,22,0,0" Click="OfflineLogin_Click" />
                </StackPanel>

                <StackPanel x:Name="PanelMsa" Visibility="Collapsed">
                    <TextBlock Text="Azure 应用 ID（client_id）" Style="{StaticResource SectionTitle}"
                               Margin="0,8,0,0" />
                    <TextBox x:Name="ClientIdBox" Style="{StaticResource InputBox}" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="应用注册免费、无需订阅：entra.microsoft.com → 应用注册 → 新注册，账户类型选「任何组织目录 + 个人 Microsoft 账户」，重定向 URI 选「公共客户端」填 http://localhost。注意：新应用的 ID 还要通过 Mojang 白名单审核，否则换令牌会 403。" />

                    <Button x:Name="WebLoginButton" Content="打开微软登录页（邮箱 + 密码）"
                            Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                            Click="WebLogin_Click" />
                    <Button x:Name="StartButton" Content="用设备码登录（备用）" Style="{StaticResource GhostButton}"
                            Margin="0,8,0,0" Click="StartLogin_Click" />

                    <Border x:Name="CodePanel" Visibility="Collapsed" Margin="0,14,0,0"
                            Background="{StaticResource BrushAccentLight}" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="在浏览器里输入这个代码" Style="{StaticResource CaptionText}" />
                            <TextBlock x:Name="UserCodeText" FontSize="26" FontWeight="Bold"
                                       FontFamily="{StaticResource FontMono}"
                                       Foreground="{StaticResource BrushAccent}" Margin="0,6,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="打开浏览器" Style="{StaticResource GhostButton}"
                                        Height="30" FontSize="12" Click="OpenBrowser_Click" />
                                <Button Content="复制代码" Style="{StaticResource GhostButton}"
                                        Height="30" FontSize="12" Margin="8,0,0,0" Click="CopyCode_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="MsaStatus" Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" Margin="0,12,0,0" />
                    <Button Content="申请 Minecraft API 白名单（aka.ms/mce-reviewappid）"
                            Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                            Height="28" FontSize="11.5" Padding="10,0" Margin="0,8,0,0"
                            Click="OpenReviewForm_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
